@model MenuViewModel
@{
    ViewData["Title"] = "Menu";
}

<section class="py-5" style="background:linear-gradient(135deg,var(--dark2),#3d1a00);min-height:180px;display:flex;align-items:center">
    <div class="container text-center">
        <h1 class="text-white mb-2">Our Menu</h1>
        <p style="color:rgba(255,255,255,.7)">Fresh, authentic Mexican food made with love 🌮</p>
    </div>
</section>

<section class="py-5">
    <div class="container">

        <!-- Category Filter -->
        <div class="category-filters">
            <a asp-controller="Menu" asp-action="Index"
               class="filter-btn @(string.IsNullOrEmpty(Model.SelectedCategory) ? "active" : "")">
                All Items
            </a>
            @foreach (var cat in Model.Categories)
            {
                <a asp-controller="Menu" asp-action="Index" asp-route-category="@cat"
                   class="filter-btn @(Model.SelectedCategory == cat ? "active" : "")">
                    @(cat == "Tacos" ? "🌮" : cat == "Burritos" ? "🌯" : cat == "Nachos" ? "🧀" : "🥤") @cat
                </a>
            }
        </div>

        @if (!Model.MenuItems.Any())
        {
            <div class="text-center text-muted py-5">
                <div style="font-size:4rem">🍽</div>
                <h4 class="mt-3">No items found</h4>
                <p>Try a different category or check back later.</p>
            </div>
        }
        else
        {
            <!-- Group by category if showing All -->
            @if (string.IsNullOrEmpty(Model.SelectedCategory))
            {
                @foreach (var group in Model.MenuItems.GroupBy(m => m.Category))
                {
                    <h3 class="mt-5 mb-4" style="color:var(--dark2);border-bottom:3px solid var(--orange);padding-bottom:10px">
                        @(group.Key == "Tacos" ? "🌮" : group.Key == "Burritos" ? "🌯" : group.Key == "Nachos" ? "🧀" : "🥤")
                        @group.Key
                    </h3>
                    <div class="row g-4 mb-3">
                        @foreach (var item in group)
                        {
                            @await Html.PartialAsync("_MenuItemCard", item)
                        }
                    </div>
                }
            }
            else
            {
                <div class="row g-4">
                    @foreach (var item in Model.MenuItems)
                    {
                        @await Html.PartialAsync("_MenuItemCard", item)
                    }
                </div>
            }
        }
    </div>
</section>
