@{
    ViewData["Title"] = "Contact";
}

<section class="py-5" style="background:linear-gradient(135deg,var(--dark2),#3d1a00);min-height:180px;display:flex;align-items:center">
    <div class="container text-center">
        <h1 class="text-white mb-2">Contact Us</h1>
        <p style="color:rgba(255,255,255,.7)">We'd love to hear from you 💬</p>
    </div>
</section>

<section class="py-5">
    <div class="container" style="max-width:700px">
        <div class="row g-4">
            <div class="col-md-5">
                <h5>Find Us</h5>
                <p class="text-muted">
                    <i class="fas fa-map-marker-alt text-mexican-red me-2"></i>
                    KG 123 Street, Kigali, Rwanda
                </p>
                <p class="text-muted">
                    <i class="fas fa-phone text-mexican-orange me-2"></i>
                    +250 700 000 000
                </p>
                <p class="text-muted">
                    <i class="fas fa-envelope text-mexican-yellow me-2"></i>
                    hello@elrancho.rw
                </p>
                <hr>
                <h6>Opening Hours</h6>
                <p class="text-muted small mb-1">Mon–Thu: 11am – 9pm</p>
                <p class="text-muted small mb-1">Fri–Sat: 11am – 11pm</p>
                <p class="text-muted small">Sunday: 12pm – 8pm</p>
            </div>
            <div class="col-md-7">
                <div class="checkout-card">
                    <h5 class="mb-4">Send a Message</h5>
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" class="form-control" placeholder="Your name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" placeholder="you@example.com" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Message</label>
                        <textarea class="form-control" rows="4" placeholder="How can we help?"></textarea>
                    </div>
                    <button class="btn-checkout">
                        <i class="fas fa-paper-plane me-2"></i>Send Message
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>
