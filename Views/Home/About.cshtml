@{
    ViewData["Title"] = "About Us";
}

<section class="py-5" style="background:linear-gradient(135deg,var(--dark2),#3d1a00);min-height:180px;display:flex;align-items:center">
    <div class="container text-center">
        <h1 class="text-white mb-2">About El Rancho</h1>
        <p style="color:rgba(255,255,255,.7)">Our Story 🌮</p>
    </div>
</section>

<section class="py-5">
    <div class="container" style="max-width:800px">
        <div class="row g-5 align-items-center">
            <div class="col-md-6">
                <div style="font-size:8rem;text-align:center">👨‍🍳</div>
            </div>
            <div class="col-md-6">
                <h2>Authentic Flavors Since 2015</h2>
                <p class="text-muted">El Rancho was founded with one mission: to bring the bold, vibrant flavors of authentic Mexican cuisine to our community. Every recipe has been passed down through generations and perfected with love.</p>
                <p class="text-muted">We source our ingredients fresh every morning, prepare everything in-house, and serve with pride. From street-style tacos to loaded burritos, every dish tells a story.</p>
            </div>
        </div>

        <div class="row g-4 mt-3 text-center">
            <div class="col-md-4">
                <div style="font-size:3rem">🌶</div>
                <h5 class="mt-2">Bold Spices</h5>
                <p class="text-muted small">We import authentic Mexican spices and chiles for real flavor.</p>
            </div>
            <div class="col-md-4">
                <div style="font-size:3rem">🥑</div>
                <h5 class="mt-2">Fresh Daily</h5>
                <p class="text-muted small">Guacamole, salsas, and proteins prepared fresh every morning.</p>
            </div>
            <div class="col-md-4">
                <div style="font-size:3rem">❤️</div>
                <h5 class="mt-2">Made with Love</h5>
                <p class="text-muted small">Our chefs care deeply about every plate that leaves the kitchen.</p>
            </div>
        </div>
    </div>
</section>
