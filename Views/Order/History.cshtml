@model List<Order>
@{
    ViewData["Title"] = "My Orders";
}

<section class="py-5" style="background:linear-gradient(135deg,var(--dark2),#3d1a00);min-height:140px;display:flex;align-items:center">
    <div class="container">
        <h1 class="text-white mb-0"><i class="fas fa-history me-3"></i>My Orders</h1>
    </div>
</section>

<section class="py-5">
    <div class="container">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <div style="font-size:5rem">📦</div>
                <h3 class="mt-3">No orders yet</h3>
                <p class="text-muted">Place your first order and it will appear here!</p>
                <a asp-controller="Menu" asp-action="Index" class="btn-hero-primary d-inline-block mt-3">
                    Browse Menu
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table cart-table">
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>Date</th>
                            <th>Items</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="fw-bold">#@order.Id</td>
                                <td>@order.OrderDate.ToString("MMM dd, yyyy HH:mm")</td>
                                <td>@order.OrderDetails.Count item(s)</td>
                                <td class="fw-bold text-mexican-red">$@order.TotalAmount.ToString("F2")</td>
                                <td>
                                    @{
                                        var badgeClass = order.Status switch {
                                            OrderStatus.Paid      => "bg-success",
                                            OrderStatus.Preparing => "bg-warning text-dark",
                                            OrderStatus.Ready     => "bg-info text-dark",
                                            OrderStatus.Delivered => "bg-secondary",
                                            OrderStatus.Cancelled => "bg-danger",
                                            _                     => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass">@order.Status</span>
                                    @if (order.IsPaid)
                                    {
                                        <span class="badge bg-success ms-1">✓ Paid</span>
                                    }
                                </td>
                                <td>
                                    <a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id"
                                       class="btn btn-sm btn-outline-secondary">
                                        View Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
