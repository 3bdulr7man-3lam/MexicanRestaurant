@model List<Order>
@{
    ViewData["Title"] = "All Orders";
}

<section class="py-4" style="background:var(--dark2)">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h1 class="text-white mb-0"><i class="fas fa-clipboard-list me-3 text-mexican-yellow"></i>All Orders</h1>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Orders" class="btn btn-sm btn-outline-light @(ViewBag.StatusFilter == null ? "active" : "")">All</a>
            @foreach (var status in Enum.GetNames<OrderStatus>())
            {
                <a asp-action="Orders" asp-route-status="@status"
                   class="btn btn-sm btn-outline-light @(ViewBag.StatusFilter == status ? "active" : "")">@status</a>
            }
        </div>
    </div>
</section>

<section class="py-4">
    <div class="container">
        @if (!Model.Any())
        {
            <p class="text-muted">No orders found.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table cart-table shadow-sm">
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Items</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Paid</th>
                            <th>Update Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="fw-bold">#@order.Id</td>
                                <td>@(order.User?.FullName ?? order.User?.Email ?? "—")</td>
                                <td>@order.OrderDate.ToString("MMM dd, HH:mm")</td>
                                <td>@order.OrderDetails.Count</td>
                                <td class="fw-bold text-mexican-red">$@order.TotalAmount.ToString("F2")</td>
                                <td>
                                    <span class="badge @(order.Status == OrderStatus.Paid ? "bg-success" :
                                        order.Status == OrderStatus.Pending ? "bg-secondary" :
                                        order.Status == OrderStatus.Preparing ? "bg-warning text-dark" : "bg-info text-dark")">
                                        @order.Status
                                    </span>
                                </td>
                                <td>@(order.IsPaid ? "✅" : "❌")</td>
                                <td>
                                    <form asp-action="UpdateOrderStatus" method="post" class="d-flex gap-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@order.Id" />
                                        <select name="status" class="form-select form-select-sm" style="width:auto">
                                            @foreach (var status in Enum.GetValues<OrderStatus>())
                                            {
                                                <option value="@status" selected="@(order.Status == status)">@status</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
