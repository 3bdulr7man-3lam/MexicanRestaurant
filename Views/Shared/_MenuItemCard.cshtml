@model MenuItem

<div class="col-sm-6 col-lg-4 col-xl-3">
    <div class="menu-card card h-100">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Name"
                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
            <div class="card-img-placeholder" style="display:none">
                @(Model.Category == "Tacos" ? "🌮" : Model.Category == "Burritos" ? "🌯" : Model.Category == "Nachos" ? "🧀" : "🥤")
            </div>
        }
        else
        {
            <div class="card-img-placeholder">
                @(Model.Category == "Tacos" ? "🌮" : Model.Category == "Burritos" ? "🌯" : Model.Category == "Nachos" ? "🧀" : "🥤")
            </div>
        }
        <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-1">
                <h5 class="card-title mb-0">@Model.Name</h5>
                @if (Model.IsFeatured)
                {
                    <span class="badge bg-warning text-dark ms-1" style="font-size:.65rem">⭐ Popular</span>
                }
            </div>
            <p class="card-text flex-grow-1 mt-1">@Model.Description</p>
            <div class="d-flex justify-content-between align-items-center mt-auto pt-3">
                <span class="price-tag">$@Model.Price.ToString("F2")</span>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Cart" asp-action="Add" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="menuItemId" value="@Model.Id" />
                        <input type="hidden" name="quantity" value="1" />
                        <button type="submit" class="btn-add-cart" style="width:auto;padding:8px 16px">
                            <i class="fas fa-cart-plus me-1"></i>Add to Cart
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login"
                       asp-route-returnUrl="@Url.Action("Index","Menu")"
                       class="btn btn-sm btn-outline-secondary">
                        Login to Order
                    </a>
                }
            </div>
        </div>
    </div>
</div>
